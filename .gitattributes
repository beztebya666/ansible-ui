# Normalise line endings. Dev is on Windows but the app builds/runs on Linux —
# shell scripts, Dockerfiles and YAML MUST stay LF or they break in the container.
* text=auto eol=lf

*.sh        text eol=lf
*.bash      text eol=lf
Dockerfile  text eol=lf
*.Dockerfile text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
Makefile    text eol=lf
*.go        text eol=lf

# Windows scripts keep CRLF
*.ps1       text eol=crlf
*.cmd       text eol=crlf
*.bat       text eol=crlf

# Binary assets — never normalise
*.png       binary
*.jpg       binary
*.gif       binary
*.woff2     binary
*.ico       binary
*.tgz       binary
*.gz        binary
