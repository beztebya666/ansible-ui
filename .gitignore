# Build artifacts
/bin/
/dist/
*.exe
*.out

# Go
/vendor/

# Node / frontend
web/node_modules/
web/dist/
web/.vite/
*.log

# Local env
.env
.env.local
deploy/.env

# Editor
.idea/
.vscode/
*.swp
.DS_Store

