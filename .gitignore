/data/
*.retry

# Local screenshots / scratch
/.shots/
/tmp-demo/
*.tmp
*.bin

# Embedded SPA build output — regenerated by the frontend build (and rm+copied in
# the Docker build). Ignore the CONTENTS but keep the dir via .gitkeep so
# `go:embed all:dist` still compiles on a fresh clone. (Ignore dir/* not dir/ —
# git won't descend into an ignored dir, so `!dir/.gitkeep` only works this way.)
/internal/webui/dist/*
!/internal/webui/dist/.gitkeep

# Air-gapped install bundles (deploy/bundle.sh output)
ansible-ui-airgapped-*.tgz

# Local Claude Code / agent state (a shared .claude/settings.json may still be committed)
.claude/settings.local.json
.claude/*.lock

# Local repo-seed scratch
/.testrepo/
