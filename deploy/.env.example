# Copy to deploy/.env and adjust. docker compose reads it automatically.

# --- exposed ports -----------------------------------------------------
WEB_PORT=8080          # the web UI
API_PORT=8090          # direct API access (debugging)

# --- postgres ----------------------------------------------------------
POSTGRES_USER=ansible
POSTGRES_PASSWORD=ansible
POSTGRES_DB=ansible_ui

# --- api ---------------------------------------------------------------
LOG_LEVEL=info         # info | debug
# SEED_DEMO=true       # seed the demo project on first boot (set false to skip)
